# Local only. `pnpm provision:zitadel` does not write this file; copy it to `.env.local`
# and fill the Zitadel values for this project's own OIDC client.
PLATFORM_API_URL=http://localhost:4000
PLATFORM_API_KEY=
ZITADEL_ISSUER=http://localhost:8080
# This app's own sign-in client, which the launch made; the launch view shows it (ADR 0032).
ZITADEL_CLIENT_ID=
ZITADEL_PROJECT_ID=
AUTH_SESSION_SECRET=
# The platform's customer organisation, for the customer area (ADR 0030) when bluebulb.json has
# "customers": true. The launcher sets it on staging.
ZITADEL_CUSTOMER_ORG_ID=
APP_URL=http://localhost:3300
ACCESS_API_URL=http://localhost:4000
# Only when bluebulb.json lists "email". The launcher sets these; never paste a live key here.
EMAIL_API_URL=http://localhost:4100
EMAIL_API_KEY=
