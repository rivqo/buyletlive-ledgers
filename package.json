{
  "name": "@bluebulb/app-template",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js app template: a branded product shell with a dashboard, design page, users and roles, and a help centre with a tour for every page. Product screens go under app/(app).",
  "scripts": {
    "dev": "next dev --port 3300",
    "build": "next build",
    "start": "next start --port 3300",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-docs.ts",
    "bluebulb:update": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/update.ts",
    "tours:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-tours.ts"
  },
  "dependencies": {
    "@bluebulb/core": "0.1.0",
    "@bluebulb/email": "0.2.1",
    "@bluebulb/platform": "0.5.1",
    "@bluebulb/sdk-core": "0.2.0",
    "@bluebulb/staff-auth": "0.1.2",
    "@bluebulb/tokens": "0.1.1",
    "@bluebulb/ui": "0.1.4",
    "lucide-react": "~1.49.0",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@bluebulb/config": "0.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
